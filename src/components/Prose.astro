<div class="prose">
  <slot />
</div>

<script>
  // 为所有 markdown 渲染的 table 自动包裹横向滚动容器
  function setupTables() {
    document.querySelectorAll('.prose table').forEach((table) => {
      if (!table.parentElement?.classList.contains('table-wrapper')) {
        const wrapper = document.createElement('div');
        wrapper.className = 'table-wrapper';
        table.parentNode?.insertBefore(wrapper, table);
        wrapper.appendChild(table);
      }
    });
  }

  // 全屏画廊查看器 (Mermaid 图表 & Markdown 图片通用的全屏缩放模态框)
  function setupMediaZoom() {
    let modal = document.getElementById('media-zoom-modal');
    if (!modal) {
      modal = document.createElement('div');
      modal.id = 'media-zoom-modal';
      modal.className = 'media-zoom-modal';
      modal.innerHTML = `
        <div class="zoom-backdrop"></div>
        <button type="button" class="zoom-close-btn" aria-label="关闭全屏 (Esc)">&times;</button>
        <div class="zoom-content-box">
          <div class="zoom-canvas"></div>
        </div>
      `;
      document.body.appendChild(modal);
    }

    const backdrop = modal.querySelector<HTMLElement>('.zoom-backdrop');
    const closeBtn = modal.querySelector<HTMLElement>('.zoom-close-btn');
    const canvas = modal.querySelector<HTMLElement>('.zoom-canvas');
    const contentBox = modal.querySelector<HTMLElement>('.zoom-content-box');

    let isCurrentSvg = false;
    let baseInitialScale = 1;
    let currentScale = 1;
    let posX = 0;
    let posY = 0;
    let isPinching = false;
    let isDragging = false;
    let startDist = 0;
    let startScale = 1;
    let startX = 0;
    let startY = 0;
    let lastTapTime = 0;

    function applyTransform(smooth = false) {
      if (!canvas) return;
      canvas.style.transition = smooth ? 'transform 0.25s cubic-bezier(0.16, 1, 0.3, 1)' : 'none';
      canvas.style.transform = `translate3d(${posX}px, ${posY}px, 0) scale(${currentScale})`;
    }

    function resetZoom() {
      currentScale = baseInitialScale;
      posX = 0;
      posY = 0;
      applyTransform(true);
    }

    function openModal(contentNode: Node) {
      if (!modal || !canvas) return;
      canvas.innerHTML = '';
      const clone = contentNode.cloneNode(true) as HTMLElement;

      isCurrentSvg = contentNode instanceof SVGElement || clone.tagName?.toLowerCase() === 'svg';
      baseInitialScale = 1;

      // 严格计算全屏模式下最大不超过页面 90% 的安全尺寸
      const safeMaxW = window.innerWidth * 0.9;
      const safeMaxH = window.innerHeight * 0.9;

      if (isCurrentSvg) {
        const svgEl = clone as unknown as SVGSVGElement;
        const vb = svgEl.viewBox?.baseVal;
        const origW = vb?.width || parseFloat(clone.getAttribute('width') || '800');
        const origH = vb?.height || parseFloat(clone.getAttribute('height') || '500');

        // 扣除内边距 padding 48px 计算可用空间
        const pad = 48;
        const availW = safeMaxW - pad;
        const availH = safeMaxH - pad;
        const fitRatio = Math.min(availW / origW, availH / origH);

        // 自适应缩放至恰好占满 90% 视窗的最大边界，绝不超出 90%
        const optimalW = Math.min(origW * fitRatio, availW);
        const optimalH = Math.min(origH * fitRatio, availH);

        clone.style.width = `${optimalW}px`;
        clone.style.height = `${optimalH}px`;
        clone.style.maxWidth = `${safeMaxW}px`;
        clone.style.maxHeight = `${safeMaxH}px`;
        clone.style.boxSizing = 'border-box';
        clone.style.margin = '0';
      } else {
        clone.style.maxWidth = `${safeMaxW}px`;
        clone.style.maxHeight = `${safeMaxH}px`;
        clone.style.objectFit = 'contain';
        clone.style.boxSizing = 'border-box';
        clone.style.margin = '0';
      }

      canvas.appendChild(clone);
      resetZoom();

      modal.classList.add('active');
      document.documentElement.style.overflow = 'hidden';
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      if (!modal) return;
      modal.classList.remove('active');
      document.documentElement.style.overflow = '';
      document.body.style.overflow = '';
      setTimeout(() => {
        if (canvas) canvas.innerHTML = '';
      }, 200);
    }

    // 1. 点击遮罩背景或关闭按钮退出全屏
    backdrop?.addEventListener('click', closeModal);
    closeBtn?.addEventListener('click', closeModal);
    contentBox?.addEventListener('click', (e) => {
      if (e.target === contentBox) {
        closeModal();
      }
    });

    // 2. 按下 ESC 键退出全屏
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal?.classList.contains('active')) {
        closeModal();
      }
    });

    // 3. 移动端触控交互：双击放大、双指捏合缩放 (Pinch-to-zoom)、单指拖拽平移
    contentBox?.addEventListener('touchstart', (e: TouchEvent) => {
      const now = Date.now();
      if (e.touches.length === 1) {
        if (now - lastTapTime < 300) {
          // 双击在 1x (完整的 90% 视界) 与 2.2x 局部放大之间切换
          if (currentScale > 1.05) {
            resetZoom();
          } else {
            currentScale = 2.2;
            posX = 0;
            posY = 0;
            applyTransform(true);
          }
          lastTapTime = 0;
          e.preventDefault();
          return;
        }
        lastTapTime = now;

        if (currentScale > 1) {
          isDragging = true;
          startX = e.touches[0].clientX - posX;
          startY = e.touches[0].clientY - posY;
        }
      } else if (e.touches.length === 2) {
        isPinching = true;
        isDragging = false;
        startDist = Math.hypot(
          e.touches[0].clientX - e.touches[1].clientX,
          e.touches[0].clientY - e.touches[1].clientY
        );
        startScale = currentScale;
      }
    }, { passive: false });

    contentBox?.addEventListener('touchmove', (e: TouchEvent) => {
      if (isPinching && e.touches.length === 2) {
        e.preventDefault();
        const dist = Math.hypot(
          e.touches[0].clientX - e.touches[1].clientX,
          e.touches[0].clientY - e.touches[1].clientY
        );
        currentScale = Math.min(Math.max(1, startScale * (dist / startDist)), 4.5);
        applyTransform(false);
      } else if (isDragging && e.touches.length === 1) {
        e.preventDefault();
        posX = e.touches[0].clientX - startX;
        posY = e.touches[0].clientY - startY;
        applyTransform(false);
      }
    }, { passive: false });

    contentBox?.addEventListener('touchend', (e: TouchEvent) => {
      if (e.touches.length === 0) {
        isPinching = false;
        isDragging = false;
        if (currentScale < 1) {
          resetZoom();
        }
      }
    });

    // 4. 桌面端鼠标滚轮微调缩放
    contentBox?.addEventListener('wheel', (e: WheelEvent) => {
      e.preventDefault();
      const delta = e.deltaY < 0 ? 0.2 : -0.2;
      currentScale = Math.min(Math.max(1, currentScale + delta), 4.5);
      if (currentScale <= 1.02) {
        currentScale = 1;
        posX = 0;
        posY = 0;
      }
      applyTransform(true);
    }, { passive: false });

    // 5. 绑定所有 Mermaid 流程图与 Markdown 图片的点击全屏
    function bindZoomEvents() {
      // Mermaid 容器点击放大
      document.querySelectorAll<HTMLElement>('.mermaid-chart-wrapper').forEach((wrapper) => {
        if (wrapper.dataset.zoomBound) return;
        wrapper.dataset.zoomBound = 'true';
        wrapper.style.cursor = 'zoom-in';
        wrapper.setAttribute('title', '点击全屏查看');
        wrapper.addEventListener('click', () => {
          const svg = wrapper.querySelector('svg');
          if (svg) openModal(svg);
        });
      });

      // Markdown 正文图片点击放大
      document.querySelectorAll<HTMLImageElement>('.prose img').forEach((img) => {
        if (img.dataset.zoomBound) return;
        img.dataset.zoomBound = 'true';
        img.style.cursor = 'zoom-in';
        img.setAttribute('title', '点击全屏查看');
        img.addEventListener('click', () => {
          openModal(img);
        });
      });
    }

    bindZoomEvents();
    // 异步保险触发
    setTimeout(bindZoomEvents, 400);
    setTimeout(bindZoomEvents, 1200);
  }

  // 代码块右上角复制按钮 (hover 显示、复制反馈、2s 或 mouseleave 重置)
  function setupCodeCopyButtons() {
    const codeBlocks = document.querySelectorAll<HTMLElement>('.prose pre:not([data-language="mermaid"])');

    codeBlocks.forEach((pre) => {
      if (pre.dataset.copyBound) return;
      pre.dataset.copyBound = 'true';

      const copyBtn = document.createElement('button');
      copyBtn.type = 'button';
      copyBtn.className = 'code-copy-btn';
      copyBtn.textContent = '复制';
      copyBtn.setAttribute('aria-label', '复制代码内容');

      let timer: number | null = null;

      function resetToCopy() {
        if (timer) {
          clearTimeout(timer);
          timer = null;
        }
        copyBtn.textContent = '复制';
        copyBtn.classList.remove('copied');
      }

      copyBtn.addEventListener('click', async (e) => {
        e.stopPropagation();
        const codeEl = pre.querySelector('code');
        const textToCopy = codeEl ? codeEl.innerText : pre.innerText;

        try {
          await navigator.clipboard.writeText(textToCopy);
        } catch {
          const textarea = document.createElement('textarea');
          textarea.value = textToCopy;
          document.body.appendChild(textarea);
          textarea.select();
          (document as any)['execCommand']?.('copy');
          document.body.removeChild(textarea);
        }

        copyBtn.textContent = '已复制';
        copyBtn.classList.add('copied');

        if (timer) clearTimeout(timer);
        timer = window.setTimeout(resetToCopy, 2000);
      });

      // 鼠标离开该代码块后，立即重置为“复制”
      pre.addEventListener('mouseleave', () => {
        resetToCopy();
      });

      pre.appendChild(copyBtn);
    });
  }

  function initProse() {
    setupTables();
    setupMediaZoom();
    setupCodeCopyButtons();
  }

  initProse();
  document.addEventListener('astro:page-load', initProse);
</script>

