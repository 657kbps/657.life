    width: 100%;
    overflow-x: auto;
    margin: 2em 0;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    background-color: var(--color-surface);
    scrollbar-width: thin;
    scrollbar-color: #c9c9c2 transparent;
    box-shadow: none !important;
  }

  .prose :global(.table-wrapper)::-webkit-scrollbar {
    height: 6px;
  }

  .prose :global(.table-wrapper)::-webkit-scrollbar-thumb {
    background-color: #c9c9c2;
    border-radius: 999px;
  }

  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.8125rem;
    line-height: 1.6;
    text-align: left;
    margin: 0;
    min-width: 480px;
  }

  .prose :global(thead) {
    background-color: var(--color-code-bg);
    border-bottom: 1px solid var(--color-border);
  }

  .prose :global(th) {
    font-family: var(--font-heading);
    font-weight: 700;
    color: var(--color-text);
    padding: 0.625rem 0.875rem;
    border-right: 1px solid var(--color-border);
    white-space: nowrap;
  }

  .prose :global(th:last-child) {
    border-right: none;
  }

  .prose :global(td) {
    padding: 0.625rem 0.875rem;
    border-bottom: 1px solid var(--color-border);
    border-right: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    vertical-align: top;
  }

  .prose :global(td:last-child) {
    border-right: none;
  }

  .prose :global(tbody tr:last-child td) {
    border-bottom: none;
  }

  .prose :global(tbody tr:hover) {
    background-color: rgba(0, 0, 0, 0.018);
  }

  /* Mermaid 矢量图表容器（支持点击全屏查看与呼吸感） */
  .prose :global(.mermaid-chart-wrapper) {
    margin: 2.5em 0;
    padding: 2rem 1.5rem;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow-x: auto;
    box-shadow: none !important;
    scrollbar-width: thin;
    scrollbar-color: #c9c9c2 transparent;
    width: 100%;
    transition: border-color 0.15s ease;
  }

  .prose :global(.mermaid-chart-wrapper:hover) {
    border-color: #adada6;
  }

  .prose :global(.mermaid-chart-wrapper svg) {
    max-width: 100%;
    height: auto;
    display: block;
    box-shadow: none !important;
    filter: none !important;
  }

  .prose :global(.mermaid-chart-wrapper svg *) {
    box-shadow: none !important;
    filter: none !important;
    text-shadow: none !important;
  }

  /* 彻底消除饼图外围的深色大圆圈边框 */
  .prose :global(.mermaid-chart-wrapper svg .pieOuterCircle) {
    stroke: none !important;
    stroke-width: 0 !important;
    display: none !important;
  }

  /* 全屏查看模态框 (Media Zoom Lightbox) */
  :global(.media-zoom-modal) {
    position: fixed;
    inset: 0;
    z-index: 99999;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s ease, visibility 0.25s ease;
    pointer-events: none;
  }

  :global(.media-zoom-modal.active) {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  :global(.zoom-backdrop) {
    position: absolute;
    inset: 0;
    background-color: rgba(18, 18, 18, 0.82); /* 略透明黑色遮罩 */
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }

  :global(.zoom-close-btn) {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    width: 38px;
    height: 38px;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 50%;
    color: #ffffff;
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 100002;
    transition: all 0.15s ease;
  }

  :global(.zoom-close-btn:hover) {
    background: rgba(255, 255, 255, 0.28);
    transform: scale(1.05);
  }

  :global(.zoom-content-box) {
    position: relative;
    width: 100vw;
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    z-index: 100001;
    touch-action: none;
    cursor: grab;
  }

  :global(.zoom-content-box:active) {
    cursor: grabbing;
  }

  :global(.zoom-canvas) {
    display: flex;
    align-items: center;
    justify-content: center;
    transform-origin: center center;
    will-change: transform;
    max-width: 90vw;
    max-height: 90vh;
  }

  :global(.zoom-canvas svg) {
    max-width: 90vw !important;
    max-height: 90vh !important;
    width: auto;
    height: auto;
    background-color: var(--color-surface);
    padding: 1.5rem;
    border-radius: 6px;
    border: 1px solid var(--color-border);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.45);
    box-sizing: border-box;
  }

  :global(.zoom-canvas img) {
    max-width: 90vw !important;
    max-height: 90vh !important;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 4px;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.45);
    box-sizing: border-box;
  }
</style>