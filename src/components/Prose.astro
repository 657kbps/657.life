    color: var(--color-text-secondary);
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin-bottom: 1.5em;
    padding-left: 1.5em;
  }

  .prose :global(li) {
    margin-bottom: 0.375em;
  }

  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background-color: var(--color-code-bg);
    padding: 0.125em 0.375em;
    border-radius: 3px;
  }

  .prose :global(pre) {
