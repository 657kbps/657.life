    border-radius: 4px;
    overflow-x: auto;
    margin: 1.5em 0;
    line-height: 1.5;
    scrollbar-color: #c9c9c2 transparent;
    scrollbar-width: thin;
  }

  /* 代码块右上角极简纯文本复制按钮：无背景、无容器、无边框，采用 mono font */
  .prose :global(.code-copy-btn) {
    position: absolute;
    top: 0.75rem;
    right: 0.875rem;
    padding: 0;
    margin: 0;
    font-family: var(--font-mono) !important;
    font-size: 0.75rem;
    line-height: 1;
    color: var(--color-text-tertiary);
    background: none !important;
    border: none !important;
    border-radius: 0;
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.15s ease, visibility 0.15s ease, color 0.15s ease;
    user-select: none;
    z-index: 5;
  }

  .prose :global(pre:hover .code-copy-btn) {
    opacity: 1;
    visibility: visible;
  }

  .prose :global(.code-copy-btn:hover) {
    color: var(--color-text);
  }

  .prose :global(.code-copy-btn.copied) {
    color: #436436;
    font-weight: 500;
  }

  .prose :global(pre)::-webkit-scrollbar {
    width: 10px;
    height: 10px;
  }

  .prose :global(pre)::-webkit-scrollbar-track {
    background: transparent;
  }

  .prose :global(pre)::-webkit-scrollbar-thumb {
    background-color: #c9c9c2;
    border: 3px solid var(--color-code-bg);
    border-radius: 999px;
  }

  .prose :global(pre)::-webkit-scrollbar-thumb:hover {
    background-color: #adada6;
  }

  .prose :global(pre code) {
    background: none;
    padding: 0;
    font-size: 0.8125rem;
  }

  .prose :global(hr) {
