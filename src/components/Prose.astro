    margin: 1.5em 0;
    transition: opacity 0.15s ease;
  }

  .prose :global(img:hover) {
    opacity: 0.95;
  }

  .prose :global(strong) {
    font-weight: 600;
  }

  /* Table 优雅渲染与排版能力 */
